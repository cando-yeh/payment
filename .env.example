# Supabase
PUBLIC_SUPABASE_URL=your-supabase-url
PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google OAuth (configured in Supabase Dashboard)
# No need to add here, just enable in Supabase Auth settings

# Environment# 環境設定
PUBLIC_APP_ENV=development

# Google OAuth (建立於 Google Cloud Console)
# Client Secret 應直接填入 Supabase Dashboard，不建議存放在此
PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Notification (Resend + QStash)
APP_BASE_URL=http://localhost:5173
NOTIFY_DRAIN_URL=
NOTIFY_DRAIN_TOKEN=
QSTASH_TOKEN=
NOTIFY_QSTASH_DELAY_SECONDS=5
NOTIFY_QSTASH_RETRIES=2

# Resend API key（https://resend.com → API Keys）
RESEND_API_KEY=
# 寄件位址，網域須先在 Resend 完成驗證；可用 "報銷系統 <no-reply@yourdomain.com>" 格式
NOTIFY_EMAIL_FROM=no-reply@yourdomain.com

NOTIFY_BATCH_SIZE=20
# Resend 預設速率上限為每秒數個請求，補送積壓時靠這個節流
NOTIFY_RATE_DELAY_MS=250
NOTIFY_EMAIL_TIMEOUT_MS=15000
NOTIFY_MAX_ATTEMPTS_CAP=5
